{
  "name": "karaoke-app",
  "version": "0.1.0",
  "description": "Local karaoke server for Shooter's DJ gigs — serves CDG+MP3 pairs from E:\\karaoke to any browser on the local Wi-Fi.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "test": "node --test \"scripts/*.test.js\" \"server/*.test.js\"",
    "measure": "node scripts/measure-parse-coverage.js",
    "rescan": "node server/index.js --rescan",
    "check": "eslint . && knip",
    "lint": "eslint ."
  },
  "dependencies": {
    "cdgraphics": "^7.0.0",
    "express": "^4.19.2",
    "sortablejs": "^1.15.7",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.12.0",
    "knip": "^6.35.1",
    "nodemon": "^3.1.0",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=24"
  }
}
