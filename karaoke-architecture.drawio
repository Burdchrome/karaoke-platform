          <mxGeometry x="20" y="50" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="djc" value="DJ device&#xa;( /dj )" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="cli">
          <mxGeometry x="20" y="140" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="acc" value="Access" style="swimlane;startSize=30;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="120" width="200" height="240" as="geometry" />
        </mxCell>
        <mxCell id="wifi" value="Local Wi-Fi (LAN)&#xa;laptop:3000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="acc">
          <mxGeometry x="20" y="50" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tun" value="Cloudflare Tunnel&#xa;( ephemeral HTTPS )" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="acc">
          <mxGeometry x="20" y="140" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="srv" value="HP Laptop - Node + Express  ( :3000 )" style="swimlane;startSize=34;html=1;fillColor=#ffffff;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="400" height="430" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="Static UIs&#xa;public (app.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="srv">
          <mxGeometry x="20" y="50" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="auth" value="djAuth&#xa;(HTTP Basic Auth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="srv">
          <mxGeometry x="210" y="50" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rsong" value="GET /api/songs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="srv">
          <mxGeometry x="20" y="120" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rstr" value="GET /api/stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="srv">
          <mxGeometry x="210" y="120" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rq" value="/api/queue  [auth]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="srv">
          <mxGeometry x="20" y="175" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rev" value="/api/events SSE  [auth]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="srv">
          <mxGeometry x="210" y="175" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lib" value="library.js&#xa;in-memory song index" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="srv">
          <mxGeometry x="20" y="240" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q" value="queue.js&#xa;in-memory, EventEmitter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="srv">
          <mxGeometry x="210" y="240" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="songmap" value="songsById Map&#xa;id to song, O(1) lookup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="srv">
          <mxGeometry x="115" y="335" width="170" height="55" as="geometry" />
        </mxCell>

        <mxCell id="stg" value="External Drive ( E: )" style="swimlane;startSize=30;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1030" y="160" width="220" height="240" as="geometry" />
        </mxCell>
        <mxCell id="drv" value="E: drive karaoke&#xa;65,672 CDG and MP3 pairs" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="stg">
          <mxGeometry x="30" y="45" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="library-cache.json" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="stg">
          <mxGeometry x="30" y="155" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="leg" value="ID model&#xa;&#xa;songId  = SHA-1 of file path, 12 chars  (which song; stable, content-addressed)&#xa;entryId = fresh id per queue slot  (which queue line; lets a song be queued twice)&#xa;&#xa;State: queue is in-memory (lost on restart). No cookies or sessions.&#xa;Auth on /dj, queue, events via DJ_USER / DJ_PASS. Audience side open." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="460" height="160" as="geometry" />
        </mxCell>

        <mxCell id="gh" value="GitHub  -  Burdchrome/karaoke-platform&#xa;&#xa;Visibility: PRIVATE&#xa;Default branch: main  (clean, in sync with origin)&#xa;Latest: a26690f - Initial commit (code and design docs), 2026-06-19&#xa;Remote: github.com/Burdchrome/karaoke-platform.git" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="560" width="460" height="140" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="browse / preview / queue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cli" target="acc">
